# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Recommended: Supabase (https://supabase.com) or Neon (https://neon.tech)
# 1. Create a project
# 2. Go to Project Settings -> Database
# 3. Copy the Connection Pooling URL (for DATABASE_URL)
# 4. Copy the Direct Connection URL (for DIRECT_URL)
DATABASE_URL="postgres://[user]:[password]@[host]:[port]/[db]?pgbouncer=true"
DIRECT_URL="postgres://[user]:[password]@[host]:[port]/[db]"

# ==============================================================================
# AUTHENTICATION (NextAuth)
# ==============================================================================
# 1. Run `npx auth secret` in your terminal or `openssl rand -base64 32`
# 2. Paste the generated string below.
NEXTAUTH_SECRET="your-generated-secret-here"
# Local development URL. Change to your production domain when deployed.
NEXTAUTH_URL="http://localhost:3000"

# ==============================================================================
# OUTBOUND EMAIL (SMTP for sending RFQs)
# ==============================================================================
# Recommended: Resend (https://resend.com), SendGrid, or standard Gmail SMTP
# If using Gmail: Use an "App Password" instead of your real password.
# 1. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"

# ==============================================================================
# INBOUND EMAIL (IMAP for reading Vendor Quotes)
# ==============================================================================
# Usually the same as your SMTP credentials.
# Note: For Gmail, ensure IMAP is enabled in Gmail Settings -> Forwarding and POP/IMAP
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_USER="your-email@gmail.com"
IMAP_PASSWORD="your-app-password"

# ==============================================================================
# AI EXTRACTION (Phase 6 - Optional but recommended)
# ==============================================================================
# Recommended: Anthropic Claude API
# 1. Go to https://console.anthropic.com/
# 2. Create an account, add credits, and go to "API Keys"
# 3. Generate a new key and paste it below.
ANTHROPIC_API_KEY="sk-ant-api03-..."
